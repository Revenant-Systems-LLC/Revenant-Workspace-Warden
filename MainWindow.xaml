<Window x:Class="RevenantWorkspaceWarden.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revenant Workspace Warden" Height="900" Width="1440"
        MinHeight="700" MinWidth="1100"
        WindowStyle="SingleBorderWindow" Background="{StaticResource BgApp}"
        Topmost="False" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Icon="Assets/rww_logo.png"
        Loaded="Window_Loaded" Closed="Window_Closed"
        KeyDown="Window_KeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Gold gradient for the Ghost Theory wordmark -->
        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5E0B0" Offset="0.0"/>
            <GradientStop Color="#DFBE81" Offset="0.4"/>
            <GradientStop Color="#B8924A" Offset="0.75"/>
            <GradientStop Color="#8B6720" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Dark combobox template (shared by ProviderSelector + ModelSelector) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Name="ToggleButton"
                              BorderBrush="#DFBE81" BorderThickness="1"
                              Background="#0f131a" Foreground="#DFBE81"
                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay,
                                RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="#0f131a" BorderBrush="#DFBE81" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="4,2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="▼" Foreground="#DFBE81"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  Margin="6,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid Name="DropDown" SnapsToDevicePixels="True"
                          MinWidth="{TemplateBinding ActualWidth}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border x:Name="DropDownBorder" Background="#0f131a"
                                BorderThickness="1" BorderBrush="#DFBE81"/>
                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0f131a"/>
            <Setter Property="Foreground" Value="#DFBE81"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#DFBE81"/>
                                <Setter Property="Background" Value="#1A2840"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#DFBE81"/>
                                <Setter Property="Background" Value="#172030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem style -->
        <Style x:Key="WorkspaceTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,1"/>
            <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E2E42"/>
                    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172030"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ── Root Grid: Header / Content / StatusBar ──────────────────────── -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: branded header -->
            <RowDefinition Height="*"/>     <!-- Row 1: 3-panel content -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: status bar -->
        </Grid.RowDefinitions>

        <!-- ── App background, painted first, under everything ──────────────
             Was Assets/Circuits.png at 0.28, which never rendered: Circuits.png
             is declared <None> in the csproj, and a relative Source resolves
             against embedded resources, so the lookup silently failed. Same
             class of bug as the fonts. tex-circuit-wide.jpg is registered as a
             <Resource>, so this one actually paints.

             Black marble hexagons with gold grout and sparse turquoise inlay.
             Deliberately the gold-weighted texture: Sidekick runs a hex tile
             where the hexagons themselves are turquoise, so the two are plainly
             related without being the same skin. Same motif, inverted emphasis. -->
        <Image Grid.RowSpan="3"
               Source="Assets/tex-hexgold.jpg"
               Stretch="UniformToFill"
               Opacity="0.6"
               IsHitTestVisible="False"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 0 — Branded Header                                         -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel>
                <!-- Right: window controls -->
                <!-- Left: workspace collapse toggle -->
                <Button DockPanel.Dock="Left" Name="WorkspaceToggleBtn" Content="◄ WS"
                        Width="50" Height="26" Margin="0,0,8,0"
                        Background="Transparent" Foreground="{StaticResource TextMuted}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                        Click="WorkspaceToggleBtn_Click" Cursor="Hand"
                        ToolTip="Toggle workspace panel"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="CourseBtn" Content="COURSE ►"
                            Width="84" Height="26" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{StaticResource Gold}"
                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                            FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                            Click="CourseBtn_Click" Cursor="Hand"/>
                    <Button Name="SidekickBtn" Content="SIDEKICK ►"
                            Width="96" Height="26" Margin="0,0,10,0"
                            Background="Transparent" Foreground="{StaticResource Gold}"
                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                            FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                            Click="SidekickBtn_Click" Cursor="Hand"/>
                    <Button Content="—" Width="26" Height="26"
                            Background="Transparent" Foreground="{StaticResource TextMuted}"
                            BorderThickness="0" Click="MinimizeBtn_Click"/>
                    <Button Content="⛶" Width="26" Height="26"
                            Background="Transparent" Foreground="{StaticResource TextMuted}"
                            BorderThickness="0" Click="MaximizeBtn_Click"/>
                    <Button Content="✕" Width="26" Height="26"
                            Background="Transparent" Foreground="#C07050"
                            BorderThickness="0" Click="CloseBtn_Click"/>
                </StackPanel>

                <!-- Right-of-title: status badge -->
                <Border DockPanel.Dock="Right" Background="#1A2840"
                        BorderBrush="#2A3A50" BorderThickness="1"
                        CornerRadius="3" Padding="6,2" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="● Warden Active" Foreground="#DFBE81"
                               FontFamily="Consolas" FontSize="11"/>
                </Border>

                <!-- Wordmark art, not type. Obsidian lettering with gold outlines
                     and a turquoise shield — the gold-leaning cut of the two, which
                     is why Warden gets this one and not the turquoise-lettered
                     version. Was "REVENANT WORKSPACE WARDEN" set in Ghost Theory. -->
                <Image Source="Assets/rww.png"
                       Height="52" Stretch="Uniform"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 1 — 3-panel content (6 cols)                               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceCol" Width="220" MinWidth="0"/>  <!-- Col 0: Workspace Tree -->
                <ColumnDefinition Width="4"/>                             <!-- Col 1: Splitter -->
                <ColumnDefinition Width="*" MinWidth="300"/>             <!-- Col 2: Code Telemetry -->
                <ColumnDefinition Width="4"/>                             <!-- Col 3: Splitter -->
                <ColumnDefinition x:Name="CourseCol" Width="0"/>           <!-- Col 4: COURSE -->
                <ColumnDefinition x:Name="SidekickCol" Width="0"/>      <!-- Col 5: Sidekick -->
            </Grid.ColumnDefinitions>

            <!-- ── Col 0: Workspace Tree ─────────────────────────────── -->
            <Border Grid.Column="0" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- WORKSPACE label -->
                        <RowDefinition Height="Auto"/>  <!-- Set Root button -->
                        <RowDefinition Height="*"/>     <!-- TreeView -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1" Padding="8,6">
                        <TextBlock Text="WORKSPACE"
                                   FontFamily="{StaticResource GhostFont}"
                                   Foreground="{StaticResource Gold}" FontSize="13"/>
                    </Border>

                    <Button Grid.Row="1" Content="Set Root"
                            Margin="6,4,6,4" Padding="4,3"
                            Background="{StaticResource BgPanel}"
                            Foreground="{StaticResource Gold}"
                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                            Click="SetWorkspaceRoot_Click" Cursor="Hand"/>

                    <TreeView Grid.Row="2" Name="WorkspaceTree"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimary}"
                              ItemContainerStyle="{StaticResource WorkspaceTreeItemStyle}"
                              SelectedItemChanged="WorkspaceTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource TextPrimary}"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ── Col 1: GridSplitter ───────────────────────────────── -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── Col 2: WARDEN — Code Chalkboard ──────────────────────── -->
            <Border Grid.Column="2" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>              <!-- Row 0: WARDEN header -->
                        <RowDefinition Height="2*" MinHeight="80"/> <!-- Row 1: Code chalkboard -->
                        <RowDefinition Height="Auto"/>              <!-- Row 2: Metrics bar -->
                        <RowDefinition Height="4"/>                 <!-- Row 3: Resize splitter -->
                        <RowDefinition Height="*" MinHeight="60"/>  <!-- Row 4: Response area -->
                        <RowDefinition Height="Auto"/>              <!-- Row 5: Loading panel -->
                        <RowDefinition Height="Auto"/>              <!-- Row 6: Chat input -->
                        <RowDefinition Height="Auto"/>              <!-- Row 7: Engine settings -->
                        <RowDefinition Height="Auto"/>              <!-- Row 8: Footer -->
                    </Grid.RowDefinitions>

                    <!-- ── Row 0: WARDEN header ──────────────────────────── -->
                    <Border Grid.Row="0" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- WARDEN label -->
                                <ColumnDefinition Width="Auto"/>  <!-- LangBadge -->
                                <ColumnDefinition Width="*"/>     <!-- FileBreadcrumb -->
                                <ColumnDefinition Width="Auto"/>  <!-- buttons -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="WARDEN"
                                       FontFamily="{StaticResource GhostFont}"
                                       Foreground="{StaticResource Gold}" FontSize="13"
                                       Margin="0,0,10,0" VerticalAlignment="Center"/>

                            <Border Grid.Column="1" Background="#1A2434"
                                    BorderBrush="#2A3A50" BorderThickness="1"
                                    CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Name="LangBadge" Text="—"
                                           Foreground="{StaticResource Gold}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                            </Border>

                            <TextBlock Grid.Column="2" Name="FileBreadcrumb"
                                       Text="— paste or load code —"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="Consolas" FontSize="11"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- Attach, QUIZ, TUTOR, CHECK buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Name="AttachBtn" Content="+"
                                        Width="28" Height="26" Margin="0,0,4,0"
                                        Background="{StaticResource GoldGradient}"
                                        Foreground="#ffffff" FontWeight="Bold"
                                        Click="AttachBtn_Click" Cursor="Hand"
                                        ToolTip="Attach File for Review"/>
                                <ToggleButton Name="QuizModeBtn" Content="QUIZ"
                                              Width="46" Height="26" FontSize="10" FontWeight="Bold"
                                              Background="{StaticResource BgPanel}"
                                              Foreground="{StaticResource TextMuted}"
                                              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                              Margin="0,0,2,0"
                                              Checked="QuizModeBtn_Checked"
                                              Unchecked="QuizModeBtn_Unchecked"
                                              ToolTip="Quiz Mode — fast answer + why"/>
                                <ToggleButton Name="TutorModeBtn" Content="TUTOR"
                                              Width="52" Height="26" FontSize="10" FontWeight="Bold"
                                              Background="{StaticResource BgPanel}"
                                              Foreground="{StaticResource TextMuted}"
                                              BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                              Margin="0,0,6,0"
                                              Checked="TutorModeBtn_Checked"
                                              Unchecked="TutorModeBtn_Unchecked"
                                              ToolTip="Tutor Mode — inline chalkboard annotations"/>
                                <Button Content="▶ CHECK"
                                        Height="26" Padding="10,2"
                                        Background="{StaticResource BgPanel}"
                                        Foreground="{StaticResource Gold}"
                                        BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                        Click="AnalyzeWithWarden_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Row 1: Code chalkboard (editable) ─────────────── -->
                    <RichTextBox Grid.Row="1" Name="CodeViewer"
                                 IsReadOnly="False"
                                 FontFamily="Consolas" FontSize="12"
                                 Foreground="{StaticResource TextCode}"
                                 Background="{StaticResource BgPanel}" BorderThickness="0"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Padding="8,6"/>

                    <!-- ── Row 2: Metrics bar ─────────────────────────────── -->
                    <Border Grid.Row="2" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,1"
                            Padding="4,3">
                        <WrapPanel Name="MetricsBar" Orientation="Horizontal"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- ── Row 3: Horizontal splitter ────────────────────── -->
                    <GridSplitter Grid.Row="3" Height="4"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{StaticResource BorderColor}"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- ── Row 4: Response area ───────────────────────────── -->
                    <ScrollViewer Grid.Row="4" Name="ChatScroller"
                                  VerticalScrollBarVisibility="Auto" Margin="0,4,0,4">
                        <ItemsControl Name="ChatHistory">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="{Binding Margin}">

                                        <!-- Thinking expander -->
                                        <Expander Header="Thinking..."
                                                  Foreground="{StaticResource TextMuted}"
                                                  Visibility="{Binding HasThinkText,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Margin="0,0,0,4">
                                            <TextBox Text="{Binding ThinkText, Mode=OneWay}"
                                                     Foreground="{StaticResource TextMuted}"
                                                     TextWrapping="Wrap" Margin="10,4,0,4"
                                                     IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Expander>

                                        <!-- Main message text -->
                                        <TextBox Text="{Binding DisplayText, Mode=OneWay}"
                                                 Foreground="{Binding TextColor}"
                                                 FontWeight="{Binding TextWeight}"
                                                 FontStyle="{Binding TextStyle}"
                                                 TextWrapping="Wrap" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"/>

                                        <!-- Tutor: syllabus area tag -->
                                        <TextBlock Text="{Binding SyllabusArea}"
                                                   Foreground="#DFBE81"
                                                   FontWeight="SemiBold" FontSize="11"
                                                   Margin="0,4,0,2"
                                                   Visibility="{Binding SyllabusArea,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Tutor: Before / After code -->
                                        <Expander Header="Before / After"
                                                  Foreground="{StaticResource Gold}"
                                                  Margin="0,4,0,2"
                                                  Visibility="{Binding BeforeCode,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="Before:" Foreground="#c87070"
                                                           FontSize="10" Margin="0,2"/>
                                                <TextBox Text="{Binding BeforeCode, Mode=OneWay}"
                                                         FontFamily="Consolas" FontSize="10"
                                                         Foreground="{StaticResource TextCode}"
                                                         TextWrapping="Wrap"
                                                         Background="{StaticResource BgPanel}"
                                                         Padding="4" IsReadOnly="True" BorderThickness="0"/>
                                                <TextBlock Text="After:" Foreground="#70c870"
                                                           FontSize="10" Margin="0,6,0,2"/>
                                                <TextBox Text="{Binding AfterCode, Mode=OneWay}"
                                                         FontFamily="Consolas" FontSize="10"
                                                         Foreground="{StaticResource TextCode}"
                                                         TextWrapping="Wrap"
                                                         Background="{StaticResource BgPanel}"
                                                         Padding="4" IsReadOnly="True" BorderThickness="0"/>
                                            </StackPanel>
                                        </Expander>

                                        <!-- Tutor: Teaching notes -->
                                        <Expander Header="Teaching Notes"
                                                  Foreground="{StaticResource Gold}"
                                                  Margin="0,2,0,4"
                                                  Visibility="{Binding TeachingNotes,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBox Text="{Binding TeachingNotes, Mode=OneWay}"
                                                     Foreground="{StaticResource TextPrimary}"
                                                     TextWrapping="Wrap" FontSize="11" Margin="4"
                                                     IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent"/>
                                        </Expander>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ── Row 5: Loading indicator ───────────────────────── -->
                    <StackPanel Grid.Row="5" Name="LoadingPanel"
                                Orientation="Horizontal" HorizontalAlignment="Left"
                                Margin="8,0,0,4" Visibility="Collapsed">
                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                     Background="{StaticResource BgPanel}"
                                     Foreground="{StaticResource Gold}"
                                     BorderThickness="0" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="Warden is thinking..."
                                   Foreground="{StaticResource Gold}"
                                   FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center"/>
                        <Button Name="StopBtn" Content="◼ STOP"
                                Height="20" Padding="8,0" Margin="10,0,0,0"
                                FontSize="10" FontWeight="Bold"
                                Background="{StaticResource BgPanel}"
                                Foreground="{StaticResource Gold}"
                                BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                VerticalAlignment="Center" Cursor="Hand"
                                Click="StopGeneration_Click"
                                ToolTip="Stop the current generation"/>
                    </StackPanel>

                    <!-- ── Row 6: Chat input ──────────────────────────────
                         Sits directly under the response area, above Engine
                         Settings, so the conversation reads top-to-bottom:
                         history -> thinking indicator -> what you type.

                         InputBox_KeyDown already implements the whole input
                         path (Enter sends, Shift+Enter newlines, /save /activate
                         /tutor /quick /screen, everything else -> DispatchLlmAsync).
                         It was Visibility="Collapsed" in the old Row 7 with the
                         comment "hidden compat elements", which left six features
                         unreachable. Nothing was wrong with the logic. -->
                    <Border Grid.Row="6" Background="{StaticResource BgSurface}"
                            BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- WPF has no placeholder, so the hint is a TextBlock
                                 behind the box, hidden on first keystroke. -->
                            <Grid Grid.Column="0">
                                <TextBox Name="InputBox"
                                         Background="{StaticResource BgPanel}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                         CaretBrush="{StaticResource Gold}"
                                         FontFamily="Consolas" FontSize="12"
                                         Padding="7,6" MinHeight="34" MaxHeight="120"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         KeyDown="InputBox_KeyDown"
                                         TextChanged="InputBox_TextChanged"/>
                                <TextBlock Name="InputHint" IsHitTestVisible="False"
                                           Text="Ask Warden anything…   Enter to send · Shift+Enter for a new line · /activate, /tutor, /quick, /screen, /save"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Button Grid.Column="1" Name="SendBtn" Content="SEND ▶"
                                    Height="34" Padding="12,0" Margin="6,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource BgPanel}"
                                    Foreground="{StaticResource Gold}"
                                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                    Click="SendBtn_Click" Cursor="Hand"
                                    ToolTip="Send to Warden"/>
                        </Grid>
                    </Border>

                    <!-- ── Row 7: Engine Settings Expander ───────────────── -->
                    <Expander Name="EngineSettingsExpander" Grid.Row="7"
                              Foreground="{StaticResource Gold}"
                              Background="{StaticResource BgPanel}">
                        <!-- Gear drawn as a Path rather than the ⚙ glyph. Ghost
                             Theory and Consolas both carry ⚙, but a Path cannot
                             be eaten by a font swap later, and this app has now
                             lost three things to exactly that. -->
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Fill="{StaticResource Gold}"
                                      VerticalAlignment="Center" Margin="0,0,7,0"
                                      Data="M8,4.5 A3.5,3.5 0 1 0 8,11.5 A3.5,3.5 0 1 0 8,4.5 Z
                                            M7,0 L9,0 L9.4,2.1 L11.2,2.9 L12.9,1.7 L14.3,3.1
                                            L13.1,4.8 L13.9,6.6 L16,7 L16,9 L13.9,9.4 L13.1,11.2
                                            L14.3,12.9 L12.9,14.3 L11.2,13.1 L9.4,13.9 L9,16
                                            L7,16 L6.6,13.9 L4.8,13.1 L3.1,14.3 L1.7,12.9
                                            L2.9,11.2 L2.1,9.4 L0,9 L0,7 L2.1,6.6 L2.9,4.8
                                            L1.7,3.1 L3.1,1.7 L4.8,2.9 L6.6,2.1 Z"/>
                                <TextBlock Text="Engine Settings"
                                           Foreground="{StaticResource Gold}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10,5,10,5">
                                <TextBlock Name="PrivacyWarning"
                                           Text="Local mode: code stays on this machine."
                                           Foreground="#DFBE81" FontStyle="Italic"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <TextBlock Text="Ollama Base URL:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBox Name="OllamaUrlBox" Text="http://localhost:11434"
                                         Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderColor}" Padding="2" Margin="0,0,0,10"
                                         LostFocus="SettingsBox_LostFocus"/>

                                <Button Name="ManageApiKeysBtn" Content="Manage API Keys"
                                        Background="{StaticResource BgPanel}"
                                        Foreground="#DFBE81"
                                        BorderBrush="#DFBE81" BorderThickness="1"
                                        Padding="5" Margin="0,0,0,10"
                                        Click="ManageApiKeysBtn_Click" Cursor="Hand"/>

                                <TextBlock Text="LLM Provider:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <ComboBox Name="ProviderSelector" Margin="0,0,0,10"
                                          Foreground="{StaticResource Gold}" SelectedIndex="0"
                                          Template="{StaticResource DarkComboBoxTemplate}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                          SelectionChanged="ProviderSelector_SelectionChanged">
                                    <ComboBoxItem Content="Ollama"/>
                                    <ComboBoxItem Content="OpenRouter"/>
                                    <ComboBoxItem Content="OpenAI"/>
                                    <ComboBoxItem Content="Anthropic"/>
                                    <ComboBoxItem Content="Groq"/>
                                    <ComboBoxItem Content="xAI"/>
                                    <ComboBoxItem Content="Gemini"/>
                                </ComboBox>

                                <TextBlock Text="Selected Model:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <ComboBox Name="ModelSelector" Margin="0,0,0,10"
                                          Foreground="{StaticResource Gold}"
                                          Template="{StaticResource DarkComboBoxTemplate}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                                          SelectionChanged="ModelSelector_SelectionChanged"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Temperature:"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Name="TempSlider"
                                            Minimum="0.0" Maximum="1.0" Value="0.7"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding ElementName=TempSlider, Path=Value, StringFormat={}{0:0.0}}"
                                               Foreground="#DFBE81" FontWeight="Bold"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Context Limit (Tokens):"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBox Name="ContextBox" Text="32768"
                                         Background="{StaticResource BgPanel}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderColor}" Padding="2"
                                         LostFocus="ContextBox_LostFocus"/>

                                <!-- Hotkeys -->
                                <TextBlock Text="Hotkeys" Foreground="{StaticResource TextMuted}"
                                           FontWeight="Bold" Margin="0,12,0,6"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Toggle Window"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="ToggleHotkeyBox"
                                             IsReadOnly="True"
                                             Background="{StaticResource BgPanel}"
                                             Foreground="#DFBE81"
                                             BorderBrush="{StaticResource BorderColor}"
                                             Padding="2,1" FontSize="11"
                                             VerticalAlignment="Center" Margin="4,0"/>
                                    <Button Grid.Column="2" Name="RebindToggleBtn" Content="Rebind"
                                            Background="{StaticResource BgPanel}"
                                            Foreground="{StaticResource Gold}"
                                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                            FontSize="10" Padding="2" Height="22"
                                            Click="RebindToggleBtn_Click" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clipboard Review"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="ClipboardHotkeyBox"
                                             IsReadOnly="True"
                                             Background="{StaticResource BgPanel}"
                                             Foreground="#DFBE81"
                                             BorderBrush="{StaticResource BorderColor}"
                                             Padding="2,1" FontSize="11"
                                             VerticalAlignment="Center" Margin="4,0"/>
                                    <Button Grid.Column="2" Name="RebindClipboardBtn" Content="Rebind"
                                            Background="{StaticResource BgPanel}"
                                            Foreground="{StaticResource Gold}"
                                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                            FontSize="10" Padding="2" Height="22"
                                            Click="RebindClipboardBtn_Click" Cursor="Hand"/>
                                </Grid>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="54"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Screen Capture"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Name="ScreenCaptureHotkeyBox"
                                             IsReadOnly="True"
                                             Background="{StaticResource BgPanel}"
                                             Foreground="#DFBE81"
                                             BorderBrush="{StaticResource BorderColor}"
                                             Padding="2,1" FontSize="11"
                                             VerticalAlignment="Center" Margin="4,0"/>
                                    <Button Grid.Column="2" Name="RebindScreenBtn" Content="Rebind"
                                            Background="{StaticResource BgPanel}"
                                            Foreground="{StaticResource Gold}"
                                            BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                            FontSize="10" Padding="2" Height="22"
                                            Click="RebindScreenBtn_Click" Cursor="Hand"/>
                                </Grid>

                                <TextBlock Name="HotkeyHint" Text=""
                                           Foreground="#DFBE81"
                                           FontSize="10" FontStyle="Italic" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Expander>

                    <!-- ── Row 8: Copyright ───────────────────────────────── -->
                    <StackPanel Grid.Row="8">
                        <!-- Street Reich, and bigger. Verified it draws © before
                             using it here — Sell Your Soul renders © as nothing. -->
                        <TextBlock Text="© Revenant Systems LLC"
                                   FontFamily="{StaticResource TitleFont}"
                                   Foreground="{StaticResource Gold}"
                                   FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,4,0,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Col 3: GridSplitter ───────────────────────────────── -->
            <GridSplitter Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderColor}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── Col 4: COURSE Panel (hidden by default) ──────────────── -->
            <Border Grid.Column="4" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Header -->
                        <RowDefinition Height="*"/>     <!-- Content -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="COURSE"
                                   FontFamily="{StaticResource GhostFont}"
                                   Foreground="{StaticResource Gold}" FontSize="16"/>
                    </Border>

                    <!-- Upsell panel (Pro not activated) -->
                    <Grid Grid.Row="1" Name="CourseUpsell" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="20,0">
                            <TextBlock Text="⬡" FontSize="44"
                                       Foreground="{StaticResource Gold}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="Course Mode"
                                       FontFamily="{StaticResource GhostFont}"
                                       Foreground="{StaticResource Gold}" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Upload your syllabus and track assignments with AI context. Requires Warden Pro."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,22"/>
                            <Button Name="CourseActivateBtn"
                                    Content="Activate Warden Pro"
                                    HorizontalAlignment="Center" Padding="16,7"
                                    Background="Transparent"
                                    Foreground="{StaticResource Gold}"
                                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="11"
                                    Click="CourseActivate_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Course content panel (Pro activated) -->
                    <Grid Grid.Row="1" Name="CourseContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>    <!-- Syllabus header -->
                            <RowDefinition Height="*"/>       <!-- Syllabus text area -->
                            <RowDefinition Height="Auto"/>    <!-- Assignment header -->
                            <RowDefinition Height="*"/>       <!-- Assignment text area -->
                            <RowDefinition Height="Auto"/>    <!-- Footer / clear -->
                        </Grid.RowDefinitions>

                        <!-- Syllabus header + upload -->
                        <Border Grid.Row="0" Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="0,0,0,1" Padding="8,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Name="CourseSyllabusUploadBtn"
                                        Content="Upload File"
                                        Height="22" Padding="6,0"
                                        Background="Transparent"
                                        Foreground="{StaticResource Gold}"
                                        BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                        FontFamily="Consolas" FontSize="10"
                                        Click="CourseSyllabusUpload_Click" Cursor="Hand"/>
                                <TextBlock Text="SYLLABUS"
                                           FontFamily="{StaticResource GhostFont}"
                                           Foreground="{StaticResource Gold}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- Syllabus text area -->
                        <TextBox Grid.Row="1" Name="CourseSyllabusBox"
                                 Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" Padding="8,6"
                                 FontFamily="Consolas" FontSize="10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="CourseText_Changed"/>

                        <!-- Assignment header -->
                        <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="0,1,0,1" Padding="8,5">
                            <TextBlock Text="ASSIGNMENT"
                                       FontFamily="{StaticResource GhostFont}"
                                       Foreground="{StaticResource Gold}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Assignment text area -->
                        <TextBox Grid.Row="3" Name="CourseAssignmentBox"
                                 Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0" Padding="8,6"
                                 FontFamily="Consolas" FontSize="10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="CourseText_Changed"/>

                        <!-- Action row -->
                        <Border Grid.Row="4" BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="0,1,0,0" Padding="6,5">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Clear Course Data"
                                        Height="22" Padding="8,0"
                                        Background="Transparent"
                                        Foreground="{StaticResource TextMuted}"
                                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                        FontFamily="Consolas" FontSize="10"
                                        Click="CourseClear_Click" Cursor="Hand"/>
                                <Button Content="▶ WARDEN NOTES"
                                        Height="22" Padding="10,0"
                                        Background="Transparent"
                                        Foreground="{StaticResource Gold}"
                                        BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                        FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                        Click="CourseWardenNotes_Click" Cursor="Hand"
                                        ToolTip="Send syllabus + assignment to Warden for study notes"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Col 5: RWS Sidekick Panel (hidden by default) ─────── -->
            <Border Grid.Column="5" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderColor}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="0,0,0,1" Padding="10,7">
                        <TextBlock Text="RWS"
                                   FontFamily="{StaticResource GhostFont}"
                                   Foreground="{StaticResource Gold}" FontSize="16"/>
                    </Border>

                    <!-- Upsell panel (Pro not activated) -->
                    <Grid Grid.Row="1" Name="SidekickUpsell" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Margin="20,0">
                            <TextBlock Text="⬡" FontSize="44"
                                       Foreground="{StaticResource Gold}"
                                       HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock Text="Revenant Workspace Sidekick"
                                       FontFamily="{StaticResource GhostFont}"
                                       Foreground="{StaticResource Gold}" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="Security scanner for AI-coded apps. Requires Warden Pro."
                                       Foreground="{StaticResource TextMuted}" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,0,22"/>
                            <Button Name="SidekickActivateBtn"
                                    Content="Activate Warden Pro"
                                    HorizontalAlignment="Center" Padding="16,7"
                                    Background="Transparent"
                                    Foreground="{StaticResource Gold}"
                                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="11"
                                    Click="SidekickActivate_Click" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scanner panel (Pro activated) -->
                    <Grid Grid.Row="1" Name="SidekickScanner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- folder picker -->
                            <RowDefinition Height="Auto"/>  <!-- scan button -->
                            <RowDefinition Height="Auto"/>  <!-- grade banner -->
                            <RowDefinition Height="*"/>     <!-- findings list -->
                            <RowDefinition Height="Auto"/>  <!-- status text -->
                        </Grid.RowDefinitions>

                        <!-- Folder picker -->
                        <Grid Grid.Row="0" Margin="6,8,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Name="SidekickPathBox"
                                     Background="#800d1624"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                     Padding="5,4" FontFamily="Consolas" FontSize="10"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="…" Width="28" Height="28"
                                    Margin="4,0,0,0"
                                    Background="Transparent"
                                    Foreground="{StaticResource Gold}"
                                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                    FontFamily="Consolas" FontSize="13"
                                    Click="SidekickBrowse_Click" Cursor="Hand"/>
                        </Grid>

                        <!-- Scan button -->
                        <Button Grid.Row="1" Name="SidekickScanBtn"
                                Content="▶  SCAN PROJECT"
                                Margin="6,0,6,8" Height="30"
                                Background="Transparent"
                                Foreground="{StaticResource Gold}"
                                BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                Click="SidekickScan_Click" Cursor="Hand"/>

                        <!-- Grade banner -->
                        <Border Grid.Row="2" Name="SidekickGradeBanner"
                                Visibility="Collapsed"
                                Margin="6,0,6,8" Padding="10,8"
                                BorderThickness="1" CornerRadius="3">
                            <DockPanel>
                                <TextBlock Name="SidekickGradeLbl"
                                           DockPanel.Dock="Left"
                                           FontFamily="{StaticResource GhostFont}"
                                           FontSize="40" Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Name="SidekickScoreLbl"
                                               FontFamily="Consolas" FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Name="SidekickSummaryLbl"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Findings list -->
                        <ScrollViewer Grid.Row="3" Name="SidekickFindingsScroller"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="SidekickFindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="6,0,6,3"
                                                Background="{StaticResource BgPanel}"
                                                BorderBrush="{Binding SeverityBrush}"
                                                BorderThickness="3,0,0,0">
                                            <Border.ToolTip>
                                                <ToolTip MaxWidth="280">
                                                    <StackPanel>
                                                        <TextBlock Text="WHY"
                                                                   FontWeight="Bold"
                                                                   Foreground="#DFBE81"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding Why}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,10"/>
                                                        <TextBlock Text="FIX"
                                                                   FontWeight="Bold"
                                                                   Foreground="#3ad5a1"
                                                                   Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding Fix}"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <StackPanel Margin="7,5,7,5">
                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,0,0,2">
                                                    <Border Background="{Binding SeverityBrush}"
                                                            Padding="3,1" Margin="0,0,5,0"
                                                            CornerRadius="2">
                                                        <TextBlock Text="{Binding SeverityLabel}"
                                                                   Foreground="Black"
                                                                   FontFamily="Consolas"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding RuleId}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontFamily="Consolas" FontSize="9"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FileLine}"
                                                           Foreground="{StaticResource TextMuted}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Status text -->
                        <TextBlock Grid.Row="4" Name="SidekickStatusLbl"
                                   Margin="8,4,8,6"
                                   FontFamily="Consolas" FontSize="10"
                                   Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Row 2 — Status Bar (gunmetal blue strip, VS Code style)        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BgStatusBar}"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Name="MemoryLabel"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Text="WARDEN"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- Spotlight Tutorial Overlay (spans full window)                 -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Name="SpotlightOverlay" Grid.RowSpan="3"
              Visibility="Collapsed" Panel.ZIndex="1000" IsHitTestVisible="True">
            <Path Fill="#D8000000">
                <Path.Data>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry Rect="0,0,10000,10000"/>
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry x:Name="SpotlightHole" Rect="0,0,0,0"
                                               RadiusX="4" RadiusY="4"/>
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </Path.Data>
            </Path>

            <!-- Left-aligned so the code can place it beside whatever is being
                 highlighted. It used to be Center, which parked it mid-window
                 regardless of what it was pointing at. -->
            <Border Name="TutorialPopup" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource Gold}" BorderThickness="1"
                    CornerRadius="4" Padding="15" MaxWidth="300">
                <StackPanel>
                    <!-- Consolas, explicitly. The inherited display face has no
                         apostrophe or period glyphs, so "It's all under Engine
                         Settings." rendered as "It s all under Engine Settings"
                         — same class of silent glyph loss the csproj warns about
                         with Ghost Theory. Instructional copy needs a text face,
                         not a display one. -->
                    <TextBlock Name="TutorialText" Text="Tutorial Step"
                               FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource TextPrimary}"
                               TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Skip" Width="60" Height="26"
                                Background="Transparent"
                                Foreground="{StaticResource TextMuted}"
                                BorderThickness="0" Margin="0,0,10,0"
                                FontFamily="Consolas" FontSize="11"
                                Cursor="Hand"
                                Click="SkipTutorial_Click"/>
                        <Button Content="Next" Width="70" Height="26"
                                Background="{StaticResource BgPanel}"
                                Foreground="{StaticResource Gold}"
                                BorderBrush="{StaticResource Gold}" BorderThickness="1"
                                FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                Cursor="Hand"
                                Click="NextTutorial_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
