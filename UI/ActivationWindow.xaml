<Window x:Class="RevenantWorkspaceWarden.UI.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace Warden Pro" Height="420" Width="400"
        Background="#0a0a0a" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#dfbe81" Offset="0.0"/>
            <GradientStop Color="#c69b52" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="WORKSPACE WARDEN PRO"
                   Foreground="{StaticResource GoldGradient}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="One-time purchase. No subscriptions."
                   Foreground="#888888" FontStyle="Italic" FontSize="11" Margin="0,0,0,16"/>

        <!-- Feature list -->
        <Border Grid.Row="2" Background="#111111" BorderBrush="#222222"
                BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Pro includes:" Foreground="#3ad5a1" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Foreground="#cccccc" Margin="0,0,0,4" TextWrapping="Wrap">
                    <Run Text="  TUTOR mode"/>
                    <Run Text=" — full structured breakdown, before/after code, teaching notes" Foreground="#888888"/>
                </TextBlock>
                <TextBlock Foreground="#cccccc" Margin="0,0,0,4" TextWrapping="Wrap">
                    <Run Text="  QUIZ mode"/>
                    <Run Text=" — fast answer-key responses for timed assessments" Foreground="#888888"/>
                </TextBlock>
                <TextBlock Foreground="#cccccc" Margin="0,0,0,4" TextWrapping="Wrap">
                    <Run Text="  Axiom persona"/>
                    <Run Text=" — syllabus-aware tutor with customizable materials" Foreground="#888888"/>
                </TextBlock>
                <TextBlock Foreground="#cccccc" TextWrapping="Wrap">
                    <Run Text="  All future Pro features"/>
                    <Run Text=" — one key, forever" Foreground="#888888"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- License key input -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="License Key:" Foreground="#3ad5a1" Margin="0,0,0,5"/>
            <TextBox Name="LicenseKeyBox"
                     Background="#1e1e1e" Foreground="White"
                     BorderBrush="#3ad5a1" BorderThickness="1"
                     Padding="6,5" FontFamily="Consolas" FontSize="12"
                     CharacterCasing="Upper"
                     KeyDown="LicenseKeyBox_KeyDown"/>
        </StackPanel>

        <!-- Status message -->
        <TextBlock Grid.Row="4" Name="StatusText"
                   Text="" Foreground="#ff6b6b"
                   TextWrapping="Wrap" Margin="0,0,0,12" FontSize="11"/>

        <!-- Buttons -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="BuyNowBtn"
                    Content="Get a License →"
                    Background="Transparent" Foreground="#3ad5a1"
                    BorderThickness="0" HorizontalAlignment="Left"
                    Cursor="Hand" FontSize="11"
                    Click="BuyNowBtn_Click"/>

            <Button Grid.Column="1" Content="Cancel"
                    Width="80" Height="30"
                    Background="#1e1e1e" Foreground="#888888"
                    BorderBrush="#333333" BorderThickness="1"
                    Margin="0,0,10,0" Click="CancelBtn_Click"/>

            <Button Grid.Column="2" Name="ActivateBtn"
                    Content="Activate"
                    Width="100" Height="30"
                    Background="{StaticResource GoldGradient}"
                    Foreground="#0a0a0a" FontWeight="Bold"
                    Click="ActivateBtn_Click"/>
        </Grid>
    </Grid>
</Window>
