<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mints Warden license keys. Never shipped with the app; the private key it signs with
       lives outside every repo. Commands: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The client's own format and verifier, so every minted key is checked by the code that ships. -->
    <Compile Include="..\..\Providers\LicenseKey.cs" Link="LicenseKey.cs" />
  </ItemGroup>

</Project>
